{
  "name": "fortify-mods",
  "version": "0.1.0",
  "description": "Fortify Mods desktop shell",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^30.0.9",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.fortify.mods",
    "productName": "Fortify Mods",
    "files": [
      "index.html",
      "styles.css",
      "script.js",
      "main.js",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": "nsis"
    }
  }
}
